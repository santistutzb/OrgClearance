{
  "manifest_version": 3,
  "name": "OrgClearance (dev)",
  "version": "0.9.0",
  "description": "Salesforce access diagnosis, permission audit, object docs, org comparison and record history. Read-only.",
  "permissions": [
    "cookies",
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.force.com/*",
    "https://*.salesforce-setup.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open OrgClearance workspace",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Open the workspace"
    },
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Show or hide the panel on a Salesforce page"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.lightning.force.com/*",
        "https://*.my.salesforce.com/*",
        "https://*.my.salesforce-setup.com/*"
      ],
      "js": [
        "ui.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2"
      ],
      "matches": [
        "https://*.lightning.force.com/*",
        "https://*.my.salesforce.com/*",
        "https://*.my.salesforce-setup.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src https://*.salesforce.com https://*.force.com https://*.salesforce-setup.com; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  },
  "minimum_chrome_version": "116"
}
